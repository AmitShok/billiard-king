; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Billiard King"
config/description="A billiard-themed climb: one cue ball, one tall tower, no checkpoints."
run/main_scene="res://scenes/ui/title.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/textures/game_icon.png"
boot_splash/bg_color=Color(0.05, 0.04, 0.05, 1)
boot_splash/image="res://assets/textures/game_icon.png"
boot_splash/fullsize=false
boot_splash/use_filter=false

[autoload]

SaveData="*res://scripts/autoload/save_data.gd"
Sfx="*res://scripts/autoload/sfx.gd"

[display]

window/size/viewport_width=512
window/size/viewport_height=288
window/size/window_width_override=1536
window/size/window_height_override=864
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[physics]

common/physics_ticks_per_second=120
common/max_physics_steps_per_frame=12
common/physics_interpolation=true
2d/default_gravity=0.0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
environment/defaults/default_clear_color=Color(0.05, 0.04, 0.05, 1)
